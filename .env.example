# ============================================================
# Uncle Portfolio – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values before running.
#   cp .env.example .env
#
# NEVER commit the .env file. It is listed in .gitignore.
# ============================================================

# ----- Database ------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/uncle_portfolio
DB_USERNAME=postgres
DB_PASSWORD=change_me_strong_password

# ----- Security ------------------------------------------------
# Generate a strong random JWT secret (min 32 characters):
#   openssl rand -base64 48
JWT_SECRET=replace_with_at_least_32_char_random_secret

# Admin account credentials (seeded on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ----- CORS ----------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- File upload ---------------------------------------------
MAX_FILE_SIZE_MB=10

# ----- Frontend (Next.js) --------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080

# ----- Optional ------------------------------------------------
# JWT_EXPIRATION_MS=3600000   # default: 1 hour
# FLYWAY_ENABLED=false        # set true to run DB migrations
